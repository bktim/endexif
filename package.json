{
  "name": "endexif",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Strip EXIF and other metadata from photos. 100% client-side, files never leave your device.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:map && npm run check:cities && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:map": "node scripts/generate-world-land.mjs",
    "check:map": "node scripts/generate-world-land.mjs --check",
    "generate:cities": "node scripts/generate-cities.mjs",
    "check:cities": "node scripts/generate-cities.mjs --check"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "picscrub": "^1.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "all-the-cities": "^3.1.0",
    "d3-geo": "3.1.1",
    "topojson-client": "3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "world-atlas": "2.0.2"
  }
}
